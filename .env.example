# Copy this file to `.env` and fill in the keys you actually use.
#   cp .env.example .env
#
# `.env` is gitignored. Never commit a key. Never paste a key into a notebook
# cell — load it with python-dotenv:
#
#     from dotenv import load_dotenv; load_dotenv()
#     import os; client = OpenAI(api_key=os.environ["OPENAI_API_KEY"])
#
# An API key is OPTIONAL in this course: every graded notebook runs on free local models.
# A key is used only by optional cells and, if your team chooses, by the final project (which must
# run for under $5 of API spend). If you use one, set a monthly spending limit in the provider's console.

# --- Frontier model providers (Week 6+) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Hugging Face (Week 5+) ---
# Only needed for gated models (e.g. some Llama and Gemma checkpoints).
# Create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Optional: pin the models the notebooks default to ---
# Override if you want to run a different model without editing notebooks.
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-haiku-4-5
LOCAL_SLM=Qwen/Qwen2.5-1.5B-Instruct
